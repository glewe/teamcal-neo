{% extends "layout.twig" %}

{% block content %}
  <!-- ====================================================================
    view.database
    -->
  <div class="container content">

    <div class="col-lg-12">
      {% if showAlert and (showAlerts != 'none') %}
        {% if (showAlerts == 'all') or (showAlerts == 'warnings' and (alertData.type == 'warning' or alertData.type == 'danger')) %}
          {{ createAlertBox(alertData)|raw }}
        {% endif %}
      {% endif %}

      {{ resetTabindex() }}
      {% set colsleft = 6 %}
      {% set colsright = 6 %}

      <form class="form-control-horizontal" enctype="multipart/form-data" action="index.php?action={{ controller }}" method="post" target="_self" accept-charset="utf-8">
        <input name="csrf_token" type="hidden" value="{{ csrf_token }}">

        <div class="card">
          {% set pageHelpLink = '' %}
          {% if pageHelp %}
            {% set pageHelpLink = '<a href="' ~ CONF.controllers[controller].docurl ~ '" target="_blank" class="float-end" style="color:inherit;"><i class="bi bi-question-circle-fill bi-lg"></i></a>' %}
          {% endif %}
          <div class="card-header text-bg-{{ CONF.controllers[controller].panelColor }}">
            <i class="{{ CONF.controllers[controller].faIcon }} fa-lg me-3"></i>
            {{ LANG.db_title }}{{ pageHelpLink|raw }}</div>
          <div class="card-body">

            <div class="card">

              <div class="card-header">
                {% set pageTabs = [
                {'id': 'tab-optimize', 'href': '#panel-optimize', 'label': LANG.db_tab_optimize, 'active': true},
                {'id': 'tab-cleanup', 'href': '#panel-cleanup', 'label': LANG.db_tab_cleanup, 'active': false},
                {'id': 'tab-repair', 'href': '#panel-repair', 'label': LANG.db_tab_repair, 'active': false},
                {'id': 'tab-delete', 'href': '#panel-delete', 'label': LANG.db_tab_delete, 'active': false},
                {'id': 'tab-admin', 'href': '#panel-admin', 'label': LANG.db_tab_admin, 'active': false},
                {'id': 'tab-reset', 'href': '#panel-reset', 'label': LANG.db_tab_reset, 'active': false},
                {'id': 'tab-import', 'href': '#panel-import', 'label': LANG.db_tab_import, 'active': false},
                {'id': 'tab-dbinfo', 'href': '#panel-dbinfo', 'label': LANG.db_tab_dbinfo, 'active': false},
              ] %}
                {{ createPageTabs(pageTabs) }}
              </div>

              <div class="card-body">
                <div
                  class="tab-content" id="myTabContent">

                  <!-- Optimize Tables tab -->
                  <div class="tab-pane fade show active" id="panel-optimize" role="tabpanel" aria-labelledby="tab-optimize">
                    <div class="form-group row">
                      <div class="col-lg-12">
                        <strong>{{ LANG.db_optimize }}</strong>
                        <div class="text-normal">{{ LANG.db_optimize_comment }}</div>
                      </div>
                    </div>
                    <div class="divider"><hr></div>
                    <button type="submit" class="btn btn-success" tabindex="{{ nextTabindex() }}" name="btn_optimize">{{ LANG.btn_optimize_tables }}</button>
                  </div>

                  <!-- Cleanup tab -->
                  <div class="tab-pane fade" id="panel-cleanup" role="tabpanel" aria-labelledby="tab-cleanup">
                    <div class="form-group row">
                      <div class="col-lg-{{ colsleft }}">
                        <div class="text-bold">{{ LANG.db_clean_what }}</div>
                        <div class="text-normal">{{ LANG.db_clean_what_comment }}</div>
                      </div>
                      <div class="col-lg-{{ colsright }}">
                        <div class="form-check">
                          <label><input class="form-check-input" name="chk_cleanDaynotes" value="chk_cleanDaynotes" tabindex="{{ nextTabindex() }}" type="checkbox">{{ LANG.db_clean_daynotes }}</label>
                        </div>
                        <div class="form-check">
                          <label><input class="form-check-input" name="chk_cleanMonths" value="chk_cleanMonths" tabindex="{{ nextTabindex() }}" type="checkbox">{{ LANG.db_clean_months }}</label>
                        </div>
                        <div class="form-check">
                          <label><input class="form-check-input" name="chk_cleanTemplates" value="chk_cleanTemplates" tabindex="{{ nextTabindex() }}" type="checkbox">{{ LANG.db_clean_templates }}</label>
                        </div>
                        <div class="form-check">
                          <label><input class="form-check-input" name="chk_daynoteRegions" value="chk_daynoteRegions" tabindex="{{ nextTabindex() }}" type="checkbox">{{ LANG.db_clean_daynoteRegions }}</label>
                        </div>
                      </div>
                    </div>
                    <div class="divider"><hr></div>
                    <div class="form-group row">
                      <div class="col-lg-{{ colsleft }}">
                        <div class="text-bold">{{ LANG.db_clean_before }}</div>
                        <div class="text-normal">{{ LANG.db_clean_before_comment }}</div>
                      </div>
                      <div class="col-lg-{{ colsright }}">
                        <input id="cleanBefore" class="form-control" tabindex="{{ nextTabindex() }}" name="txt_cleanBefore" maxlength="10" value="{{ cleanBefore }}" type="text">
                        {% if inputAlert.cleanBefore is defined and inputAlert.cleanBefore|length %}
                          <br>
                          <div class="alert alert-dismissable alert-danger">
                            <button type="button" class="btn-close float-end" data-bs-dismiss="alert"></button>
                            {{ inputAlert.cleanBefore }}</div>
                        {% endif %}
                        <script>
                          $(function () {
                            $("#cleanBefore").datepicker({changeMonth: true, changeYear: true, dateFormat: "yy-mm-dd"});
                          });
                        </script>
                      </div>
                    </div>
                    <div class="divider"><hr></div>
                    <div class="form-group row">
                      <div class="col-lg-{{ colsleft }}">
                        <div class="text-bold">{{ LANG.db_clean_confirm }}</div>
                        <div class="text-normal">{{ LANG.db_clean_confirm_comment }}</div>
                      </div>
                      <div class="col-lg-{{ colsright }}">
                        <input class="form-control" tabindex="{{ nextTabindex() }}" name="txt_cleanConfirm" maxlength="7" value="" type="text">
                        {% if inputAlert.cleanConfirm is defined and inputAlert.cleanConfirm|length %}
                          <br>
                          <div class="alert alert-dismissable alert-danger">
                            <button type="button" class="btn-close float-end" data-bs-dismiss="alert"></button>
                            {{ inputAlert.cleanConfirm }}</div>
                        {% endif %}
                      </div>
                    </div>
                    <div class="divider"><hr></div>
                    <button type="submit" class="btn btn-warning" tabindex="{{ nextTabindex() }}" name="btn_cleanup">{{ LANG.btn_cleanup }}</button>
                  </div>

                  <!-- Repair tab -->
                  <div class="tab-pane fade" id="panel-repair" role="tabpanel" aria-labelledby="tab-repair">
                    <div class="form-group row">
                      <div class="col-lg-{{ colsleft }}">
                        <div class="text-bold">{{ LANG.db_repair_dbStructure }}</div>
                        <div class="text-normal">{{ LANG.db_repair_dbStructure_comment }}</div>
                      </div>
                      <div class="col-lg-{{ colsright }}">
                        <div class="form-check">
                          <label><input class="form-check-input" id="chk_dbStructure" name="chk_dbStructure" value="chk_dbStructure" tabindex="{{ nextTabindex() }}" type="checkbox">{{ LANG.db_repair_dbStructure }}</label>
                        </div>
                      </div>
                    </div>
                    <div class="divider"><hr></div>
                    <div id="dbStructure-inline-warning" class="alert alert-danger d-none mb-2" role="alert"></div>
                    <button type="button" id="btn_dbStructureCheck" class="btn btn-warning" tabindex="{{ nextTabindex() }}">{{ LANG.btn_repair }}</button>
                  </div>

                  <!-- Delete tab -->
                  <div class="tab-pane fade" id="panel-delete" role="tabpanel" aria-labelledby="tab-delete">
                    <div class="form-group row">
                      <div class="col-lg-{{ colsleft }}">
                        <div class="text-bold">{{ LANG.db_del_what }}</div>
                        <div class="text-normal">{{ LANG.db_del_what_comment }}</div>
                      </div>
                      <div class="col-lg-{{ colsright }}">
                        {% set deleteOptions = [
                        {'name': 'chk_delUsers', 'label': LANG.db_del_users},
                        {'name': 'chk_delGroups', 'label': LANG.db_del_groups},
                        {'name': 'chk_delMessages', 'label': LANG.db_del_messages},
                        {'name': 'chk_delOrphMessages', 'label': LANG.db_del_orphMessages},
                        {'name': 'chk_delPermissions', 'label': LANG.db_del_permissions},
                        {'name': 'chk_delLog', 'label': LANG.db_del_log},
                        {'name': 'chkDBDeleteArchive', 'label': LANG.db_del_archive},
                      ] %}
                        {% for option in deleteOptions %}
                          <div class="form-check">
                            <label><input class="form-check-input" name="{{ option.name }}" value="{{ option.name }}" tabindex="{{ nextTabindex() }}" type="checkbox">{{ option.label }}</label>
                          </div>
                        {% endfor %}
                      </div>
                    </div>
                    <div class="divider"><hr></div>
                    <div class="form-group row">
                      <div class="col-lg-{{ colsleft }}">
                        <div class="text-bold">{{ LANG.db_confirm }}</div>
                        <div class="text-normal">{{ LANG.db_del_confirm_comment }}</div>
                      </div>
                      <div class="col-lg-{{ colsright }}">
                        <input class="form-control" tabindex="{{ nextTabindex() }}" name="txt_deleteConfirm" maxlength="6" value="" type="text">
                        {% if inputAlert.deleteConfirm is defined and inputAlert.deleteConfirm|length %}
                          <br>
                          <div class="alert alert-dismissable alert-danger">
                            <button type="button" class="btn-close float-end" data-bs-dismiss="alert"></button>
                            {{ inputAlert.deleteConfirm }}</div>
                        {% endif %}
                      </div>
                    </div>
                    <div class="divider"><hr></div>
                    <button type="submit" class="btn btn-danger" tabindex="{{ nextTabindex() }}" name="btn_delete">{{ LANG.btn_delete_records }}</button>
                  </div>

                  <!-- Administration tab -->
                  <div class="tab-pane fade" id="panel-admin" role="tabpanel" aria-labelledby="tab-admin">
                    <div class="form-group row">
                      <div class="col-lg-12">
                        <strong>{{ LANG.db_dbURL }}</strong>
                        <div class="text-normal">{{ LANG.db_dbURL_comment }}</div>
                      </div>
                      <div class="col-lg-12 control-label mt-2">
                        <input id="dbURL" class="form-control" tabindex="{{ nextTabindex() }}" name="txt_dbURL" maxlength="160" value="{{ dbURL }}" type="text"><br>
                        <button type="submit" class="btn btn-primary" tabindex="{{ nextTabindex() }}" name="btn_saveURL">{{ LANG.btn_save }}</button>
                      </div>
                    </div>
                    {% if dbURL|length and dbURL != "#" %}
                      <div class="divider"><hr></div>
                      <a href="{{ dbURL }}" class="btn btn-info" tabindex="{{ nextTabindex() }}" target="_blank">{{ LANG.db_application }}</a>
                    {% endif %}
                  </div>

                  <!-- Reset tab -->
                  <div class="tab-pane fade" id="panel-reset" role="tabpanel" aria-labelledby="tab-reset">
                    <div class="alert alert-danger">{{ LANG.db_reset_danger|raw }}</div>
                    <div class="form-group row">
                      <div class="col-lg-8">
                        <div class="text-bold">{{ LANG.db_resetDataset }}</div>
                        <div class="text-normal">{{ LANG.db_resetDataset_comment|raw }}</div>
                      </div>
                      <div class="col-lg-4">
                        <div class="form-check">
                          <input class="form-check-input" type="radio" name="opt_dataset" id="opt_dataset_basic" value="basic" checked tabindex="{{ nextTabindex() }}">
                          <label class="form-check-label" for="opt_dataset_basic">{{ LANG.db_reset_basic }}</label>
                        </div>
                        <div class="form-check">
                          <input class="form-check-input" type="radio" name="opt_dataset" id="opt_dataset_sample" value="sample" tabindex="{{ nextTabindex() }}">
                          <label class="form-check-label" for="opt_dataset_sample">{{ LANG.db_reset_sample }}</label>
                        </div>
                      </div>
                    </div>
                    <div class="divider"><hr></div>
                    <div class="form-group row">
                      <div class="col-lg-8">
                        <div class="text-bold">{{ LANG.db_resetString }}</div>
                        <div class="text-normal">{{ LANG.db_resetString_comment|raw }}</div>
                      </div>
                      <div class="col-lg-4">
                        <input id="dbResetString" class="form-control" tabindex="{{ nextTabindex() }}" name="txt_dbResetString" maxlength="40" value="" type="text"><br>
                      </div>
                    </div>
                    <div class="divider"><hr></div>
                    <button type="submit" class="btn btn-danger" tabindex="{{ nextTabindex() }}" name="btn_reset">{{ LANG.btn_reset_database }}</button>
                  </div>

                  <!-- Import from 5.3.7 tab -->
                  <div class="tab-pane fade" id="panel-import" role="tabpanel" aria-labelledby="tab-import">
                    <div class="alert alert-info">{{ LANG.db_import_intro|raw }}</div>

                    {% if importInProgress %}
                      <div id="import-resume" class="alert alert-warning">
                        {{ LANG.db_import_resume_text }}
                        <div class="mt-2">
                          <button type="button" id="btn_importResume" class="btn btn-warning" tabindex="{{ nextTabindex() }}">{{ LANG.btn_import_resume }}</button>
                          <button type="button" id="btn_importCancel" class="btn btn-danger" tabindex="{{ nextTabindex() }}">{{ LANG.btn_import_cancel }}</button>
                        </div>
                      </div>
                    {% endif %}

                    <div id="import-setup">
                      <div class="form-group row">
                        <div class="col-lg-{{ colsleft }}">
                          <div class="text-bold">{{ LANG.db_import_folder }}</div>
                          <div class="text-normal">{{ LANG.db_import_folder_comment|raw }}</div>
                        </div>
                        <div class="col-lg-{{ colsright }}">
                          <input id="import_folder" class="form-control" tabindex="{{ nextTabindex() }}" maxlength="255" value="" placeholder="{{ LANG.db_import_folder_placeholder }}" type="text">
                        </div>
                      </div>
                      <div class="divider"><hr></div>
                      <details class="mb-3">
                        <summary class="text-bold">{{ LANG.db_import_db_details }}</summary>
                        <div class="text-normal mt-2 mb-2">{{ LANG.db_import_db_comment }}</div>
                        {% set importFields = [
                        {'id': 'import_host', 'label': LANG.db_import_host, 'type': 'text', 'value': ''},
                        {'id': 'import_port', 'label': LANG.db_import_port, 'type': 'text', 'value': ''},
                        {'id': 'import_name', 'label': LANG.db_import_name, 'type': 'text', 'value': ''},
                        {'id': 'import_user', 'label': LANG.db_import_user, 'type': 'text', 'value': ''},
                        {'id': 'import_pass', 'label': LANG.db_import_pass, 'type': 'password', 'value': ''},
                        {'id': 'import_prefix', 'label': LANG.db_import_prefix, 'type': 'text', 'value': ''},
                      ] %}
                        {% for field in importFields %}
                          <div class="form-group row mb-2">
                            <div class="col-lg-{{ colsleft }}">{{ field.label }}</div>
                            <div class="col-lg-{{ colsright }}">
                              <input id="{{ field.id }}" class="form-control" tabindex="{{ nextTabindex() }}" maxlength="160" value="" type="{{ field.type }}" autocomplete="off">
                            </div>
                          </div>
                        {% endfor %}
                      </details>
                      <button type="button" id="btn_importCheck" class="btn btn-primary" tabindex="{{ nextTabindex() }}">{{ LANG.btn_import_check }}</button>
                    </div>

                    <div id="import-check-result" class="mt-3"></div>

                    <div id="import-confirm" class="d-none mt-3">
                      <div class="divider"><hr></div>
                      <div class="alert alert-danger">{{ LANG.db_import_danger|raw }}</div>
                      <div class="form-group row">
                        <div class="col-lg-{{ colsleft }}">
                          <div class="text-bold">{{ LANG.db_confirm }}</div>
                          <div class="text-normal">{{ LANG.db_import_confirm_comment }}</div>
                        </div>
                        <div class="col-lg-{{ colsright }}">
                          <input id="import_confirm_text" class="form-control" tabindex="{{ nextTabindex() }}" maxlength="6" value="" autocomplete="off" type="text">
                        </div>
                      </div>
                      <div class="divider"><hr></div>
                      <button type="button" id="btn_importStart" class="btn btn-danger" tabindex="{{ nextTabindex() }}">{{ LANG.btn_import_start }}</button>
                    </div>

                    <div id="import-progress" class="d-none mt-3">
                      <div class="text-bold mb-2" id="import-progress-label"></div>
                      <div class="progress" role="progressbar" aria-label="{{ LANG.db_import_running }}">
                        <div id="import-progress-bar" class="progress-bar progress-bar-striped progress-bar-animated" style="width: 0%">0%</div>
                      </div>
                      <div class="text-normal mt-2">{{ LANG.db_import_running_hint }}</div>
                    </div>

                    <div id="import-result" class="mt-3"></div>
                  </div>

                  <!-- Database Information tab -->
                  <div class="tab-pane fade show" id="panel-dbinfo" role="tabpanel" aria-labelledby="tab-dbinfo">
                    <div class="form-group row">
                      <div class="col-lg-12">
                        <table class='table'>
                          <thead>
                            <tr>
                              <th>{{ LANG.attribute }}</th>
                              <th>{{ LANG.value }}</th>
                            </tr>
                          </thead>
                          <tbody>
                            {% if dbInfo is not empty %}
                              {% for attr, val in dbInfo %}
                                <tr>
                                  <td>{{ attr }}</td>
                                  <td>{{ val }}</td>
                                </tr>
                              {% endfor %}
                            {% else %}
                              <tr>
                                <td colspan="2">{{ LANG.db_no_info ?? 'No information available' }}</td>
                              </tr>
                            {% endif %}
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>

      </form>

      <!-- Database Structure Check Modal -->
      <div class="modal fade" id="modal-dbStructure" tabindex="-1" role="dialog" aria-labelledby="modal-dbStructure-label" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
          <div class="modal-content">
            <div class="modal-header">
              <h5 class="modal-title" id="modal-dbStructure-label">{{ LANG.db_repair_dbStructure }}</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-start">
              <div id="dbStructure-warning" class="alert alert-warning d-none" role="alert"></div>
              <div id="dbStructure-body"></div>
            </div>
            <div class="modal-footer">
              <button type="button" id="btn_dbStructureDismiss" class="btn btn-secondary" data-bs-dismiss="modal">{{ LANG.btn_cancel }}</button>
              <button type="button" id="btn_dbStructureFix" class="btn btn-warning d-none">{{ LANG.btn_fix }}</button>
            </div>
          </div>
        </div>
      </div>

      <script>
        // The Bootstrap bundle is included after the content block in
        // layout.twig, so defer all setup until DOMContentLoaded - by
        // then `bootstrap` is on the window.
        document.addEventListener('DOMContentLoaded', function () {
          const LANG = {
            checking:       {{ LANG.db_repair_checking|json_encode|raw }},
            applying:       {{ LANG.db_repair_applying|json_encode|raw }},
            no_issues:      {{ LANG.db_repair_no_issues|json_encode|raw }},
            select_option:  {{ LANG.db_repair_select_option|json_encode|raw }},
            backup_warning: {{ LANG.db_repair_backup_warning|json_encode|raw }},
            btn_cancel:     {{ LANG.btn_cancel|json_encode|raw }},
            btn_close:      {{ LANG.btn_close|json_encode|raw }},
          };
          const csrfToken = document.querySelector('input[name="csrf_token"]').value;
          const triggerBtn = document.getElementById('btn_dbStructureCheck');
          const chk        = document.getElementById('chk_dbStructure');
          const inlineWarn = document.getElementById('dbStructure-inline-warning');
          const modalEl    = document.getElementById('modal-dbStructure');
          const modal      = new bootstrap.Modal(modalEl);
          const warnEl     = document.getElementById('dbStructure-warning');
          const bodyEl     = document.getElementById('dbStructure-body');
          const fixBtn     = document.getElementById('btn_dbStructureFix');
          const dismissBtn = document.getElementById('btn_dbStructureDismiss');
          let lastFindings = [];
          let needsReload  = false;

          // The dismiss button starts as 'Cancel'. Once a check has
          // returned anything (findings, no-issues, or error), no work
          // is still pending, so 'Close' reads better than 'Cancel'.
          function setDismissLabel(label) {
            dismissBtn.textContent = label;
          }

          function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, c => ({
              '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
            }[c]));
          }

          function describeFinding(f) {
            switch (f.kind) {
              case 'missing_table':
                return 'Missing table <code>' + escapeHtml(f.table) + '</code>';
              case 'missing_column':
                return 'Missing column <code>' + escapeHtml(f.column) + '</code> in table <code>' + escapeHtml(f.table) + '</code>';
              case 'missing_index':
                return 'Missing index <code>' + escapeHtml(f.index) + '</code> in table <code>' + escapeHtml(f.table) + '</code>';
              case 'wrong_engine':
                return 'Table <code>' + escapeHtml(f.table) + '</code> uses storage engine <code>' + escapeHtml(f.current) + '</code> instead of InnoDB';
              case 'missing_foreign_key':
                return 'Missing foreign key <code>' + escapeHtml(f.constraint) + '</code> in table <code>' + escapeHtml(f.table) + '</code>';
              case 'missing_check':
                return 'Missing check constraint <code>' + escapeHtml(f.constraint) + '</code> in table <code>' + escapeHtml(f.table) + '</code>';
              case 'missing_config':
                return 'Missing config entry <code>' + escapeHtml(f.name) + '</code>';
              case 'mismatched_config_case':
                return 'Config entry case mismatch: <code>' + escapeHtml(f.current) + '</code> &rarr; <code>' + escapeHtml(f.name) + '</code>';
              default:
                return 'Unknown finding: ' + escapeHtml(JSON.stringify(f));
            }
          }

          function renderFindings(findings) {
            if (!findings.length) {
              warnEl.classList.add('d-none');
              bodyEl.innerHTML = '<p>' + escapeHtml(LANG.no_issues) + '</p>';
              fixBtn.classList.add('d-none');
              return;
            }
            warnEl.textContent = LANG.backup_warning;
            warnEl.classList.remove('d-none');
            let html = '<ol>';
            for (const f of findings) {
              html += '<li>' + describeFinding(f) + '</li>';
            }
            html += '</ol>';
            bodyEl.innerHTML = html;
            fixBtn.classList.remove('d-none');
          }

          function renderResults(results) {
            warnEl.classList.add('d-none');
            fixBtn.classList.add('d-none');
            let html = '<ul class="list-unstyled">';
            for (const r of results) {
              const icon = r.status === 'ok'
                ? '<span class="text-success me-1">&#10003;</span>'
                : '<span class="text-danger me-1">&#10007;</span>';
              let line = icon + describeFinding(r.finding);
              if (r.status === 'error' && r.error) {
                line += ' &mdash; <span class="text-danger">' + escapeHtml(r.error) + '</span>';
              }
              html += '<li>' + line + '</li>';
            }
            html += '</ul>';
            bodyEl.innerHTML = html;
            needsReload = true;
          }

          async function postJson(url, body) {
            const opts = {
              method: 'POST',
              headers: { 'X-CSRF-Token': csrfToken },
            };
            if (body !== undefined) {
              opts.headers['Content-Type'] = 'application/json';
              opts.body = JSON.stringify(body);
            }
            const resp = await fetch(url, opts);
            if (!resp.ok) {
              const text = await resp.text();
              throw new Error('HTTP ' + resp.status + ': ' + text);
            }
            return resp.json();
          }

          function setBusy(btn, label) {
            btn.dataset.origText = btn.dataset.origText || btn.textContent;
            btn.disabled = true;
            btn.textContent = label;
          }
          function unsetBusy(btn) {
            btn.disabled = false;
            if (btn.dataset.origText) {
              btn.textContent = btn.dataset.origText;
            }
          }

          triggerBtn.addEventListener('click', async () => {
            inlineWarn.classList.add('d-none');
            inlineWarn.textContent = '';
            if (!chk.checked) {
              inlineWarn.textContent = LANG.select_option;
              inlineWarn.classList.remove('d-none');
              return;
            }
            setDismissLabel(LANG.btn_cancel);
            setBusy(triggerBtn, LANG.checking);
            try {
              const data = await postJson('index.php?action=database&method=check');
              lastFindings = data.findings || [];
              renderFindings(lastFindings);
              setDismissLabel(LANG.btn_close);
              modal.show();
            } catch (e) {
              warnEl.classList.add('d-none');
              fixBtn.classList.add('d-none');
              bodyEl.innerHTML = '<div class="alert alert-danger">' + escapeHtml(e.message) + '</div>';
              setDismissLabel(LANG.btn_close);
              modal.show();
            } finally {
              unsetBusy(triggerBtn);
            }
          });

          fixBtn.addEventListener('click', async () => {
            setBusy(fixBtn, LANG.applying);
            try {
              const data = await postJson('index.php?action=database&method=fix', { findings: lastFindings });
              renderResults(data.results || []);
            } catch (e) {
              warnEl.classList.add('d-none');
              bodyEl.innerHTML = '<div class="alert alert-danger">' + escapeHtml(e.message) + '</div>';
              needsReload = true;
            } finally {
              unsetBusy(fixBtn);
            }
          });

          modalEl.addEventListener('hidden.bs.modal', () => {
            if (needsReload) {
              window.location.reload();
            }
          });
        });
      </script>

      <script>
        // Import from a 5.3.7 installation
        document.addEventListener('DOMContentLoaded', function () {
          const T = {
            checking:   {{ LANG.db_import_checking|json_encode|raw }},
            running:    {{ LANG.db_import_running|json_encode|raw }},
            checkOk:    {{ LANG.db_import_check_ok|json_encode|raw }},
            colTable:   {{ LANG.db_import_col_table|json_encode|raw }},
            colOld:     {{ LANG.db_import_col_old|json_encode|raw }},
            colNew:     {{ LANG.db_import_col_new|json_encode|raw }},
            confirm:    {{ LANG.db_import_err_confirm|json_encode|raw }},
            failed:     {{ LANG.db_import_failed|json_encode|raw }},
            doneTitle:  {{ LANG.db_import_done|json_encode|raw }},
            doneText:   {{ LANG.db_import_done_text|json_encode|raw }},
            notesTitle: {{ LANG.db_import_notes_title|json_encode|raw }},
            btnHome:    {{ LANG.btn_import_home|json_encode|raw }},
            cancelled:  {{ LANG.db_import_cancelled|json_encode|raw }},
            confirmCancel: {{ LANG.db_import_cancel_confirm|json_encode|raw }},
            steps: {
              wipe:          {{ LANG.db_import_step_wipe|json_encode|raw }},
              reference:     {{ LANG.db_import_step_reference|json_encode|raw }},
              config:        {{ LANG.db_import_step_config|json_encode|raw }},
              messages:      {{ LANG.db_import_step_messages|json_encode|raw }},
              log:           {{ LANG.db_import_step_log|json_encode|raw }},
              users:         {{ LANG.db_import_step_users|json_encode|raw }},
              userdata:      {{ LANG.db_import_step_userdata|json_encode|raw }},
              daynotes:      {{ LANG.db_import_step_daynotes|json_encode|raw }},
              absence_days:  {{ LANG.db_import_step_absence_days|json_encode|raw }},
              calendar_days: {{ LANG.db_import_step_calendar_days|json_encode|raw }},
              verify:        {{ LANG.db_import_step_verify|json_encode|raw }},
              files:         {{ LANG.db_import_step_files|json_encode|raw }},
            },
          };
          const csrfToken = document.querySelector('input[name="csrf_token"]').value;
          const el        = (id) => document.getElementById(id);
          const setupEl   = el('import-setup');
          const checkBtn  = el('btn_importCheck');
          const resultEl  = el('import-check-result');
          const confirmEl = el('import-confirm');
          const startBtn  = el('btn_importStart');
          const progEl    = el('import-progress');
          const barEl     = el('import-progress-bar');
          const labelEl   = el('import-progress-label');
          const doneEl    = el('import-result');
          if (!checkBtn) {
            return;
          }

          const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
          const list = (items, cls) => '<ul class="' + cls + '">' + items.map((i) => '<li>' + esc(i) + '</li>').join('') + '</ul>';

          async function post(method, body) {
            const opts = {method: 'POST', headers: {'X-CSRF-Token': csrfToken}};
            if (body !== undefined) {
              opts.headers['Content-Type'] = 'application/json';
              opts.body = JSON.stringify(body);
            }
            const resp = await fetch('index.php?action=database&method=' + method, opts);
            let data = null;
            try {
              data = await resp.json();
            } catch (e) {
              throw new Error('HTTP ' + resp.status);
            }
            if (!resp.ok) {
              throw new Error(data.error || ('HTTP ' + resp.status));
            }
            return data;
          }

          function countsTable(counts) {
            let html = '<table class="table table-sm w-auto"><thead><tr><th>' + esc(T.colTable) + '</th><th class="text-end">' + esc(T.colOld) + '</th>';
            const withNew = Object.values(counts).some((c) => typeof c === 'object' && c !== null);
            if (withNew) {
              html += '<th class="text-end">' + esc(T.colNew) + '</th><th></th>';
            }
            html += '</tr></thead><tbody>';
            for (const [name, c] of Object.entries(counts)) {
              if (typeof c === 'object' && c !== null) {
                html += '<tr><td>' + esc(name) + '</td><td class="text-end">' + (c.old === null ? '' : esc(c.old)) + '</td><td class="text-end">' + esc(c.new) + '</td><td>' + (c.into !== name ? '&rarr; ' + esc(c.into) : '') + '</td></tr>';
              } else {
                html += '<tr><td>' + esc(name) + '</td><td class="text-end">' + esc(c) + '</td></tr>';
              }
            }
            return html + '</tbody></table>';
          }

          function fail(message) {
            progEl.classList.add('d-none');
            setupEl.classList.remove('d-none');
            resultEl.innerHTML = '<div class="alert alert-danger"><strong>' + esc(T.failed) + '</strong> ' + esc(message) + '</div>';
          }

          async function drive() {
            setupEl.classList.add('d-none');
            confirmEl.classList.add('d-none');
            resultEl.innerHTML = '';
            progEl.classList.remove('d-none');
            try {
              for (;;) {
                const p = await post('import_step');
                barEl.style.width = p.percent + '%';
                barEl.textContent = p.percent + '%';
                labelEl.textContent = T.steps[p.step] || T.running;
                if (p.done) {
                  progEl.classList.add('d-none');
                  showResult(p.result);
                  return;
                }
              }
            } catch (e) {
              fail(e.message);
            }
          }

          function showResult(r) {
            let html = '<div class="alert alert-success"><strong>' + esc(T.doneTitle) + '</strong> ' + T.doneText + '</div>';
            html += countsTable(r.counts);
            html += list(r.settings, 'mb-2') + list(r.files, 'mb-2');
            if (r.notes.length) {
              html += '<div class="alert alert-warning mb-2"><strong>' + esc(T.notesTitle) + '</strong>' + list(r.notes, 'mb-0') + '</div>';
            }
            html += '<a class="btn btn-primary" href="index.php?action=home">' + esc(T.btnHome) + '</a>';
            doneEl.innerHTML = html;
          }

          checkBtn.addEventListener('click', async () => {
            confirmEl.classList.add('d-none');
            resultEl.innerHTML = '';
            checkBtn.disabled = true;
            const label = checkBtn.textContent;
            checkBtn.textContent = T.checking;
            try {
              const data = await post('import_check', {
                folder: el('import_folder').value, host: el('import_host').value, port: el('import_port').value,
                name: el('import_name').value, user: el('import_user').value, pass: el('import_pass').value, prefix: el('import_prefix').value,
              });
              if (data.errors.length) {
                resultEl.innerHTML = '<div class="alert alert-danger">' + list(data.errors, 'mb-0') + '</div>';
              } else {
                let html = '<div class="alert alert-success mb-2">' + esc(T.checkOk) + '</div>';
                if (data.warnings.length) {
                  html += '<div class="alert alert-warning">' + list(data.warnings, 'mb-0') + '</div>';
                }
                resultEl.innerHTML = html + countsTable(data.counts);
                confirmEl.classList.remove('d-none');
              }
            } catch (e) {
              resultEl.innerHTML = '<div class="alert alert-danger">' + esc(e.message) + '</div>';
            } finally {
              checkBtn.disabled = false;
              checkBtn.textContent = label;
            }
          });

          startBtn.addEventListener('click', async () => {
            if (el('import_confirm_text').value !== 'IMPORT') {
              resultEl.insertAdjacentHTML('beforeend', '<div class="alert alert-danger mt-2">' + esc(T.confirm) + '</div>');
              return;
            }
            startBtn.disabled = true;
            try {
              await post('import_start', {confirm: 'IMPORT'});
              await drive();
            } catch (e) {
              fail(e.message);
            } finally {
              startBtn.disabled = false;
            }
          });

          // An import was interrupted (page closed): continue or go back to the fresh state
          const resumeBtn = el('btn_importResume');
          if (resumeBtn) {
            resumeBtn.addEventListener('click', () => {
              el('import-resume').classList.add('d-none');
              drive();
            });
            el('btn_importCancel').addEventListener('click', async () => {
              if (!window.confirm(T.confirmCancel)) {
                return;
              }
              try {
                await post('import_cancel');
                el('import-resume').innerHTML = '<div class="alert alert-info mb-0">' + esc(T.cancelled) + '</div>';
              } catch (e) {
                fail(e.message);
              }
            });
          }

          // Enter in a field must not submit the page form
          document.querySelectorAll('#panel-import input').forEach((input) => {
            input.addEventListener('keydown', (ev) => {
              if (ev.key === 'Enter') {
                ev.preventDefault();
                if (input.id === 'import_confirm_text') {
                  startBtn.click();
                } else {
                  checkBtn.click();
                }
              }
            });
          });
        });
      </script>

    </div>
  </div>
{% endblock %}
